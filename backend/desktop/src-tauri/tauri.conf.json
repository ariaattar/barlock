{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SoundCloud DL",
  "version": "0.1.0",
  "identifier": "com.ariaattar.soundcloud-dl",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "bun run engine:build && bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SoundCloud DL",
        "width": 1440,
        "height": 900,
        "minWidth": 1040,
        "minHeight": 680,
        "center": true,
        "decorations": true,
        "transparent": false,
        "backgroundColor": "#0a0a0a"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "Music",
    "shortDescription": "SoundCloud to Rekordbox preparation",
    "longDescription": "Download, analyze, and safely sync SoundCloud tracks and playlists into Rekordbox.",
    "resources": {
      "resources/engine/": "engine/"
    }
  }
}
